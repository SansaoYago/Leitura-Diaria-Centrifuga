rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /leituras_centrifugas/{readingId} {
      allow read: if true;
      allow create, update: if request.resource.data.data is string &&
                               request.resource.data.horario is string &&
                               request.resource.data.chiller is string &&
                               request.resource.data.nome_operador is string &&
                               request.resource.data.nome_operador.size() > 0 &&
                               request.resource.data.nome_operador.size() <= 100;
      allow delete: if false;
    }
  }
}
